# ============================================================
# AUDY LEARNING CENTRE — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to git.
# ============================================================

# ── Supabase ──────────────────────────────────────────────
# Public (safe to expose to browser via PUBLIC_ prefix)
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here

# Server-only — NEVER expose to browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Application ───────────────────────────────────────────
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_APP_NAME="Audy Learning Centre"

# ── Google Drive ──────────────────────────────────────────
# Root Shared Drive folder that ALC owns.
# All module sub-folders live inside this root.
GOOGLE_DRIVE_ROOT_FOLDER_ID=your-shared-drive-root-folder-id

# Module sub-folder IDs inside the root.
# These are created once by the initialise-drive admin action
# and stored here for fast lookups without an API search.
GOOGLE_DRIVE_GROWTH_JOURNEY_FOLDER_ID=
GOOGLE_DRIVE_PRODUCT_KNOWLEDGE_FOLDER_ID=
GOOGLE_DRIVE_PLAY_LEARN_FOLDER_ID=
GOOGLE_DRIVE_LETS_PRACTICE_FOLDER_ID=
GOOGLE_DRIVE_FRESH_UPDATE_FOLDER_ID=
GOOGLE_DRIVE_QNA_FOLDER_ID=
GOOGLE_DRIVE_SYSTEM_FOLDER_ID=

# ── Google Service Account ────────────────────────────────
# Server-only — NEVER expose to browser.
# Create in: Google Cloud Console → IAM → Service Accounts
# Grant: "Storage Object Admin" on the Shared Drive
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-sa@your-project.iam.gserviceaccount.com

# The private key from the service account JSON key file.
# Paste the full value including -----BEGIN/END----- lines.
# In .env.local use double-quotes and \n for newlines, e.g.:
#   GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n"
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
